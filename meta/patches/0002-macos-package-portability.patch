# Rdragmap patch: macOS package portability
# Base: f61b9b24fed06a5602253da27bc7294e42340c9a
# Purpose: make the imported native platform layer compile with Apple Clang and
# Darwin facilities, while retaining Linux behavior and C++ driver ownership of
# the standard library.
# Regression: portable and auto native builds, Clang native build, package source
# archive audit, simulated R-universe Boost-prefix installation, and R CMD check.

diff --git a/config.mk b/config.mk
index af6bb13599b41cbb1babf6fd18de2735f5981dbe..b71f09d48ee800a85c38fcc9fae1d3825cd52c76 100755
--- a/config.mk
+++ b/config.mk
@@ -226,10 +226,10 @@ endif # ASAN
 
 LDFLAGS+= -lz -lpthread
 
+# The C++ driver owns the compatible standard library. In particular, forcing
+# -lstdc++ makes an Apple Clang link select the wrong runtime.
 ifdef STATIC_LIBCPP
 LDFLAGS+= -static-libstdc++
-else
-LDFLAGS+= -lstdc++
 endif
 
 #LDFLAGS+= -lz -lstdc++ -lrt -lgomp -lpthread
